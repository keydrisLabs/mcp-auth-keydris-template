{
  "name": "keydris-mcp-templates",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "description": "Keydris wallet and seller MCP templates for Stripe MPP",
  "author": "mcp-use",
  "license": "MIT",
  "homepage": "https://github.com/mcp-use/mcp-use",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:wallet": "npm run build --workspace @keydris/wallet-mcp",
    "build:seller": "npm run build --workspace @keydris/seller-mcp",
    "dev:wallet": "npm run dev --workspace @keydris/wallet-mcp",
    "dev:seller": "npm run dev --workspace @keydris/seller-mcp",
    "deploy:wallet": "npm run deploy --workspace @keydris/wallet-mcp",
    "deploy:seller": "npm run deploy --workspace @keydris/seller-mcp",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "mcp-use": "2.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  }
}
