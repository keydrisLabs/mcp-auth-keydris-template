# Seller Keydris gateway credential-redemption endpoint.
KEYDRIS_GATEWAY_URL=https://dev.api.keydris.com/gateway/credentials

# Legacy token header fallback. Normal MCP calls carry the token in _meta.
# KEYDRIS_TOKEN_HEADER=authorization

# Public Stripe network business profile associated with the seller connection.
STRIPE_NETWORK_ID=profile_test_example

# Used only to integrity-bind challenges. Use at least 32 random bytes.
SELLER_CHALLENGE_SIGNING_SECRET=replace-with-a-long-random-secret

# JSON array of server-authoritative products in major currency units.
SELLER_CATALOG_JSON=[{"sku":"demo-api-call","name":"Demo API call","unitAmount":"1.00","currency":"USD"}]

# Challenge lifetime, capped by the template at ten minutes.
# SELLER_CHALLENGE_TTL_SECONDS=300
