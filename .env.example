# Where this server redeems the KIT action token it was handed.
KEYDRIS_GATEWAY_URL=https://api.keydris.com/gateway/credentials

# Legacy /agent/authorize header accepted as a fallback (default: authorization).
# mcp_kit_reader requests carry their token in MCP params._meta instead.
#KEYDRIS_TOKEN_HEADER=authorization

# Upstream API base for the github-whoami demo tool.
#GITHUB_API_BASE=https://api.github.com
